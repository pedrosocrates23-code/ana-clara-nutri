---
// Card de artigo (blog, home e silos). Imagem 3:2 com srcset, selo da área e data.
import Picture from './Picture.astro';
import { formatarDataPt } from '../lib/site';
interface Props {
  post: { data: { title: string; description: string; path: string; siloLabel: string; datePublished: string; image?: string; imageAlt?: string; silo: string } };
  heading?: 'h2' | 'h3';
  featured?: boolean;
  sizes?: string;
}
const { post, heading = 'h3', featured = false, sizes = '(min-width: 1100px) 360px, (min-width: 720px) 45vw, 100vw' } = Astro.props;
const d = post.data;
const nome = d.image ? d.image.split('/').pop()!.replace(/\.webp$/, '') : '';
const H = heading;
---
<a class:list={['pcard', { 'pcard--featured': featured }]} href={d.path} data-reveal data-silo={d.silo}>
  <div class="pcard__media media">
    {nome && <Picture name={nome} alt={d.imageAlt ?? ''} sizes={featured ? '(min-width: 980px) 55vw, 100vw' : sizes} />}
    <span class="pcard__badge">{d.siloLabel}</span>
  </div>
  <div class="pcard__body">
    <H class="pcard__title">{d.title}</H>
    <p>{d.description}</p>
    <div class="pcard__foot">
      <time datetime={d.datePublished}>{formatarDataPt(d.datePublished)}</time>
      <span class="pcard__more">Ler artigo <span aria-hidden="true">→</span></span>
    </div>
  </div>
</a>

<style>
  .pcard { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; color: inherit; text-decoration: none; transition: transform .5s var(--ease-out), box-shadow .5s var(--ease-out); }
  .pcard:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); }
  .pcard__media { aspect-ratio: 3 / 2; border-radius: 0; }
  .pcard__badge {
    position: absolute; top: 14px; left: 14px; max-width: calc(100% - 28px);
    background: rgba(255, 255, 255, .92); color: var(--sage-800); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    font-size: .74rem; font-weight: 650; line-height: 1.3; padding: 6px 12px; border-radius: 999px;
  }
  .pcard__body { display: flex; flex-direction: column; gap: 10px; padding: 22px 24px 22px; flex: 1; }
  .pcard__title { margin: 0; font-family: var(--serif); font-weight: 400; font-size: 1.32rem; line-height: 1.2; letter-spacing: -.015em; }
  .pcard__body p { color: var(--ink-soft); font-size: .93rem; line-height: 1.6; margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pcard__foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 12px; border-top: 1px solid var(--line); }
  .pcard__foot time { color: var(--ink-faint); font-size: .82rem; }
  .pcard__more { color: var(--sage-700); font-weight: 650; font-size: .88rem; white-space: nowrap; }
  .pcard__more span { display: inline-block; transition: transform .4s var(--ease-out); }
  .pcard:hover .pcard__more span { transform: translateX(4px); }

  @media (min-width: 980px) {
    .pcard--featured { flex-direction: row; grid-column: 1 / -1; }
    .pcard--featured .pcard__media { flex: 1.15; aspect-ratio: auto; min-height: 420px; }
    .pcard--featured .pcard__body { flex: .85; padding: 44px; justify-content: center; }
    .pcard--featured .pcard__title { font-size: clamp(1.8rem, 2.6vw, 2.4rem); }
    .pcard--featured .pcard__body p { -webkit-line-clamp: 5; font-size: 1.02rem; }
  }
</style>

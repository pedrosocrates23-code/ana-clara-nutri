---
import { SITE, NAV, SILOS, ADDRESS_LINE, WHATSAPP_URL, TEL_URL, MAPS_LINK, HAS_CRN, CRN, CRN_SUFIXO } from '../lib/site';
const year = 2026;
---
<footer class="site-footer" data-wa-secao="Rodapé">
  <div class="container footer-top">
    <div class="footer-brand">
      <div class="brand"><img src="/logo-aca.png" alt="" width="44" height="44" loading="lazy" /><span><em>Ana&nbsp;Clara</em> <b>Nutri</b></span></div>
      <p class="muted">Nutrição com abordagem comportamental e educacional. Atendimento particular, online para todo o Brasil e presencial em Goiânia.</p>
      <a class="footer-wa" href={WHATSAPP_URL} target="_blank" rel="noopener" data-wa-secao="Rodapé · botão">
        <span class="wa-ico" aria-hidden="true"></span>
        <span><b>Agendar pelo WhatsApp</b><small>{SITE.phone}</small></span>
      </a>
    </div>

    <nav class="col" aria-label="Navegação">
      <h2 class="col__title">Navegar</h2>
      {NAV.map((i) => <a href={i.href}>{i.label}</a>)}
      <a href="/contato">Contato</a>
    </nav>

    <nav class="col" aria-label="Áreas de atuação">
      <h2 class="col__title">Áreas de atuação</h2>
      {SILOS.map((s) => <a href={s.href}>{s.label}</a>)}
      <a href="/como-eu-atendo/">Como eu atendo</a>
    </nav>

    <div class="col">
      <h2 class="col__title">Contato</h2>
      <address class="contact">
        <span>{SITE.legalName}{HAS_CRN && <><br />{CRN}</>}</span>
        <a href={MAPS_LINK} target="_blank" rel="noopener">{SITE.venue}, {ADDRESS_LINE}</a>
        <a href={TEL_URL}>Telefone: {SITE.phone}</a>
      </address>
      <div class="legal">
        <a href="/politica-de-privacidade">Política de Privacidade / LGPD</a>
        <a href="/termos-e-aviso-de-ia">Termos e Aviso de IA</a>
      </div>
    </div>
  </div>

  <!-- Marca d'água decorativa: o texto vem do CSS (::before/::after), não do DOM, para não
       entrar na leitura de tela nem na checagem de contraste (é ornamento, não conteúdo). -->
  <div class="container footer-word" aria-hidden="true"></div>

  <div class="container bottom">
    <span>© {year} {SITE.legalName}{CRN_SUFIXO}</span>
    <span>Atendimento exclusivamente particular.</span>
  </div>
</footer>

<style>
  .site-footer { background: var(--forest-ink); color: var(--sand-100); padding-block: clamp(56px, 8vw, 96px) 28px; overflow: hidden; }
  .footer-top { display: grid; gap: 40px; }
  @media (min-width: 900px) { .footer-top { grid-template-columns: 1.5fr 1fr 1.1fr 1.3fr; gap: 32px; } }
  .brand { display: flex; align-items: center; gap: 12px; font-family: var(--serif); font-size: 1.5rem; margin-bottom: 14px; color: #fff; }
  .brand img { border-radius: 12px; background: #fff; padding: 2px; }
  .brand em { font-style: italic; } .brand b { font-weight: 400; }
  .muted { color: var(--sage-200); font-size: .92rem; line-height: 1.7; max-width: 340px; }
  .footer-wa {
    display: inline-flex; align-items: center; gap: 12px; margin-top: 10px; padding: 12px 20px 12px 16px; border-radius: 999px;
    background: var(--sage-200); color: var(--forest-ink); text-decoration: none; transition: background .25s, transform .4s var(--ease-out);
  }
  .footer-wa:hover { background: #fff; transform: translateY(-2px); }
  .footer-wa span:last-child { display: grid; line-height: 1.25; }
  .footer-wa b { font-weight: 650; font-size: .95rem; }
  .footer-wa small { font-size: .78rem; opacity: .8; }
  .wa-ico { width: 22px; height: 22px; flex: none; background: currentColor; -webkit-mask: var(--wa-icon) center / contain no-repeat; mask: var(--wa-icon) center / contain no-repeat; }
  .col__title { font-family: var(--mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--sage-300); margin: 0 0 14px; font-weight: 500; }
  .col a { display: block; color: var(--sand-100); font-size: .93rem; padding: 5px 0; text-decoration: none; transition: color .2s, transform .35s var(--ease-out); }
  .col a:hover { color: #fff; transform: translateX(3px); }
  .contact { font-style: normal; display: block; font-size: .9rem; color: var(--sage-200); line-height: 1.6; }
  .contact span { display: block; margin-bottom: 8px; color: var(--sand-100); }
  .legal { margin-top: 16px; border-top: 1px solid rgba(255,255,255,.1); padding-top: 12px; }
  .legal a { font-size: .84rem; color: var(--sage-300); }
  .footer-word {
    margin-top: clamp(48px, 7vw, 80px); font-family: var(--serif); font-weight: 300; line-height: .9; letter-spacing: -.04em;
    font-size: clamp(3.4rem, 13vw, 11.5rem); color: rgba(187, 208, 182, .14); white-space: nowrap; user-select: none;
  }
  .footer-word::before { content: 'Ana Clara '; }
  .footer-word::after { content: 'Nutri'; font-style: italic; }
  .bottom { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between;
    margin-top: 24px; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.1);
    font-family: var(--mono); font-size: .72rem; color: var(--sage-300); }
</style>

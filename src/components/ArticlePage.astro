---
import { render, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from './Faq.astro';
import AuthorBox from './AuthorBox.astro';
import References from './References.astro';
import Button from './Button.astro';
import TableOfContents from './TableOfContents.astro';
import Picture from './Picture.astro';
import PostCard from './PostCard.astro';
import CtaBand from './CtaBand.astro';
import { buildGraph, SCHEMA_IDS } from '../lib/schema/shared';
import { SITE, waLink, formatarDataPt, CRN_SUFIXO } from '../lib/site';

const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);

const siloHref = data.silo === 'blog' ? '/blog' : `/${data.silo}/`;
const breadcrumb = [
  { name: 'Início', href: '/' },
  { name: data.siloLabel, href: siloHref },
  { name: data.title, href: data.path },
];

const articleNode = {
  '@type': data.medical ? 'MedicalWebPage' : 'Article',
  '@id': `${SITE.url}${data.path}#article`,
  headline: data.title,
  description: data.description,
  author: { '@id': SCHEMA_IDS.person },
  publisher: { '@id': SCHEMA_IDS.person },
  datePublished: data.datePublished,
  dateModified: data.dateModified ?? data.datePublished,
  inLanguage: 'pt-BR',
  ...(data.image ? { image: `${SITE.url}${data.image}` } : {}),
  ...(data.medical ? { lastReviewed: data.datePublished, reviewedBy: { '@id': SCHEMA_IDS.person } } : {}),
};

const graph = buildGraph({
  path: data.path, title: data.metaTitle, faqs: data.faqs, breadcrumb,
  extraNodes: [articleNode],
});

// Tempo de leitura: 200 palavras/min (leitura atenta de texto informativo em pt-BR).
const palavras = (entry.body ?? '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const minutos = Math.max(1, Math.round(palavras / 200));

const capa = data.image ? data.image.split('/').pop()!.replace(/\.webp$/, '') : '';

// Relacionados: mesma área primeiro, completa com os mais recentes.
const todos = (await getCollection('posts')).filter((p) => p.data.path !== data.path)
  .sort((a, b) => (a.data.datePublished < b.data.datePublished ? 1 : -1));
const relacionados = [...todos.filter((p) => p.data.silo === data.silo), ...todos.filter((p) => p.data.silo !== data.silo)].slice(0, 3);

const waArtigo = waLink(`Olá, Ana Clara! Li o artigo "${data.title}" e queria conversar sobre o meu caso.`);
---
<BaseLayout title={data.metaTitle} description={data.description} path={data.path} graph={graph} ogImage={data.image}>
  <div class="read-progress" data-progress aria-hidden="true"></div>

  <header class="art-head">
    <div class="container art-head__inner">
      <nav class="crumbs" aria-label="Você está em">
        <a href="/">Início</a><span aria-hidden="true">/</span><a href={siloHref}>{data.siloLabel}</a>
      </nav>
      <h1 set:html={data.h1} />
      <p class="art-head__dek">{data.description}</p>
      <div class="art-meta">
        <img src="/logo-aca.png" alt="" width="40" height="40" class="art-meta__av" />
        <div class="art-meta__who">
          <a href="/sobre">{SITE.legalName}</a>
          <span>Nutricionista{CRN_SUFIXO}</span>
        </div>
        <ul class="art-meta__facts" role="list">
          <li><time datetime={data.datePublished}>{formatarDataPt(data.datePublished)}</time></li>
          {data.dateModified && data.dateModified !== data.datePublished && <li>Atualizado em <time datetime={data.dateModified}>{formatarDataPt(data.dateModified)}</time></li>}
          <li>{minutos} min de leitura</li>
        </ul>
      </div>
    </div>
  </header>

  {capa && (
    <figure class="container art-cover">
      <div class="art-cover__frame media">
        <Picture name={capa} alt={data.imageAlt ?? ''} loading="eager" fetchpriority="high" sizes="(min-width: 1240px) 1180px, 100vw" />
      </div>
    </figure>
  )}

  <div class="section art-body">
    <div class="container art-layout">
      <article class="art-layout__content prose" data-progress-target>
        <Content />
      </article>
      <aside class="art-layout__side">
        <div class="side-sticky">
          <TableOfContents headings={headings} />
          <div class="side-cta" data-wa-secao="Artigo · lateral">
            <p class="side-cta__t">Quer olhar para o <em>seu caso</em>?</p>
            <p class="side-cta__d">Converse com a Ana pelo WhatsApp. Atendimento online ou presencial em Goiânia.</p>
            <Button href={waArtigo} variant="whatsapp" size="sm" secao="Artigo · lateral">Conversar</Button>
          </div>
        </div>
      </aside>
      <div class="art-layout__after">
        <AuthorBox />
        <p class="back"><a href={siloHref}>← Mais textos de {data.siloLabel}</a></p>
      </div>
    </div>
  </div>

  {data.faqs.length > 0 && <Faq items={data.faqs} />}

  {data.references?.length > 0 && <References items={data.references} />}

  {relacionados.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section__head"><span class="kicker">Continue lendo</span><h2>Leituras <em>relacionadas</em></h2></div>
        <div class="rel">{relacionados.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}

  <CtaBand title="Quer um acompanhamento <em>individual</em>?" text="Atendimento online para todo o Brasil ou presencial em Goiânia, sem dieta restritiva e sem culpa. O agendamento é direto pelo WhatsApp." secao="Artigo · faixa final" image={capa || 'pg-agendar'} />
</BaseLayout>

<style>
  .art-head { padding: calc(var(--header-h) + clamp(32px, 6vw, 72px)) 0 clamp(28px, 4vw, 44px); background: linear-gradient(180deg, var(--sand-50), var(--paper)); }
  .art-head__inner { max-width: calc(900px + 2 * var(--gutter)); }
  .crumbs { display: flex; gap: 8px; flex-wrap: wrap; font-family: var(--mono); font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 22px; }
  .crumbs a { color: var(--sage-700); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .crumbs span { opacity: .5; }
  .art-head h1 { font-size: clamp(2.2rem, 5vw, 3.7rem); line-height: 1.05; margin: 0; }
  .art-head h1 :global(em) { font-style: italic; color: var(--sage-600); }
  .art-head__dek { font-size: clamp(1.08rem, 1.7vw, 1.28rem); line-height: 1.55; color: var(--ink-soft); margin: 22px 0 0; max-width: 680px; }
  .art-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 18px; margin-top: 30px; padding-top: 22px; border-top: 1px solid var(--line); }
  .art-meta__av { border-radius: 50%; background: #fff; border: 1px solid var(--line); }
  .art-meta__who { display: grid; line-height: 1.3; font-size: .92rem; }
  .art-meta__who a { font-weight: 650; color: var(--ink); text-decoration: none; }
  .art-meta__who a:hover { text-decoration: underline; }
  .art-meta__who span { color: var(--ink-faint); font-size: .84rem; }
  .art-meta__facts { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 0 0 0 auto; padding: 0; font-size: .85rem; color: var(--ink-faint); }
  .art-meta__facts li + li::before { content: '·'; margin-right: 16px; }
  @media (max-width: 640px) { .art-meta__facts { margin-left: 0; width: 100%; } }

  .art-cover { margin: 0 auto; }
  .art-cover__frame { aspect-ratio: 16 / 9; border-radius: var(--r-xl); box-shadow: var(--shadow-lg); }
  @media (max-width: 640px) { .art-cover__frame { aspect-ratio: 3 / 2; border-radius: var(--r-lg); } }

  .art-body { padding-top: clamp(48px, 7vw, 88px); }
  .art-layout__side { display: none; }
  .art-layout__after { max-width: var(--maxw-prose); }
  .back { margin-top: 28px; font-weight: 650; }
  .back a { color: var(--sage-700); text-decoration: none; }
  .back a:hover { text-decoration: underline; }

  @media (min-width: 1040px) {
    .art-layout { display: grid; grid-template-columns: minmax(0, var(--maxw-prose)) 300px; column-gap: clamp(48px, 7vw, 110px); align-items: start; }
    .art-layout__content { grid-column: 1; grid-row: 1; }
    .art-layout__after { grid-column: 1; grid-row: 2; }
    .art-layout__side { display: block; grid-column: 2; grid-row: 1 / span 2; height: 100%; }
    .side-sticky { position: sticky; top: calc(var(--header-h) + 28px); display: grid; gap: 22px; }
  }
  .side-cta { background: var(--forest-ink); color: #fff; border-radius: var(--r-lg); padding: 22px; }
  .side-cta__t { font-family: var(--serif); font-size: 1.35rem; line-height: 1.2; margin: 0 0 8px; color: #fff; }
  .side-cta__t em { color: var(--sage-200); }
  .side-cta__d { font-size: .88rem; color: rgba(255,255,255,.78); margin: 0 0 16px; }
  .side-cta :global(.btn--whatsapp) { background: var(--sage-200); color: var(--forest-ink); box-shadow: none; }
  .side-cta :global(.btn--whatsapp:hover) { background: #fff; }

  .rel { display: grid; gap: 22px; }
  @media (min-width: 720px) { .rel { grid-template-columns: repeat(3, 1fr); } }
</style>

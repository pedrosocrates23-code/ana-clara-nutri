---
import Button from './Button.astro';
import FormCard from './FormCard.astro';
import { WHATSAPP_URL } from '../lib/site';
// Hero com foto (banner substituído em 23/08/2026): foto editorial da Ana com
// fundo verde escuro sólido do lado esquerdo, onde o texto se apoia sem
// precisar de overlay escuro por cima (removido a pedido — ver histórico).
// Formulário de agendamento removido do hero (desktop) em 23/08/2026 (cobria
// a foto); no lugar, dois CTAs diretos: clay (design system) para
// agendamento e outline branco, exclusivo deste hero, para WhatsApp.
// Mobile (< 760px, 23/08/2026): sem foto, fundo sólido #354a3b (cor
// específica pedida para esta seção, não é um token do design system).
// Texto claro (igual ao desktop, o mobile não tem mais fundo claro).
// 40px exatos entre o fim do menu fixo (--header-h: 72px) e a etiqueta.
// Formulário completo (FormCard) reaparece só no mobile, abaixo dos 2
// CTAs, preenchendo o espaço que sobrava vazio; no desktop continua fora,
// porque lá ele cobriria a foto.
---
<section class="hero" aria-label="Apresentação">
  <div class="hero__bg"></div>
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="kicker hero__kicker">Nutricionista</p>
      <h1 class="hero__title">Nutrição com abordagem<br /><em>comportamental e educacional</em></h1>
      <p class="hero__sub">
        Atendimento presencial em Goiânia e online por telenutrição para todo o Brasil.
        Um cuidado próximo, baseado em evidências e sem dietas restritivas.
      </p>
      <div class="hero__actions">
        <Button href="/contato" variant="clay">Agendar consulta</Button>
        <Button href={WHATSAPP_URL} variant="outline" target="_blank" rel="noopener" class="hero__btn-outline">Falar no WhatsApp</Button>
      </div>
      <div class="hero__form-mobile">
        <FormCard idPrefix="hero-m" title="Agende sua consulta" secao="Home — hero (topo, mobile)" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; min-height: 88vh; display: flex; align-items: center; overflow: hidden; }
  .hero__bg {
    position: absolute; inset: 0;
    /* Cor sólida como base instantânea (evita flash branco antes da imagem
       carregar) por trás da foto. Sem overlay escuro por cima: o próprio
       fundo verde da foto já sustenta o contraste do texto à esquerda. */
    background-color: var(--sage-800);
    background-image: url('/hero-home.webp');
    background-size: cover;
    background-position: 78% center;
    background-repeat: no-repeat;
  }
  .hero__inner {
    position: relative; z-index: 2; width: 100%;
    padding-block: clamp(96px, 13vh, 150px) clamp(40px, 7vh, 80px);
  }

  .hero__content { color: #fff; max-width: 540px; }
  .hero__kicker { color: var(--sage-100); }
  .hero__title { color: #fff; font-weight: 300; font-size: clamp(2rem, 5vw, 3.4rem); margin: 12px 0 0; }
  .hero__title em { font-style: italic; color: var(--sage-200); }
  .hero__sub { color: rgba(255,255,255,.92); font-size: clamp(1rem, 1.5vw, 1.12rem); margin: 16px 0 0; max-width: 480px; }

  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 28px; }

  /* Form completo só existe visualmente no mobile (media query abaixo);
     no desktop fica fora de fluxo para não reservar espaço nem cobrir a foto. */
  .hero__form-mobile { display: none; }

  /* Button.astro é outro componente: o CSS com escopo daqui não alcança o
     <a> que ele renderiza, então essa cor precisa do escape hatch :global.
     Outline branco só serve para o hero com foto (desktop, ver media query
     abaixo) — no mobile sem foto o próprio .btn--outline do design system
     (sage sobre fundo claro) já funciona sem nenhum override daqui. */
  @media (min-width: 760px) {
    :global(.hero__btn-outline) {
      background: transparent !important;
      color: #fff !important;
      border-color: rgba(255, 255, 255, .78) !important;
    }
    :global(.hero__btn-outline:hover) {
      border-color: #fff !important;
      background: rgba(255, 255, 255, .1) !important;
    }
  }

  /* Mobile: sem foto, fundo sólido #354a3b (cor específica pedida, entre
     --sage-700 e --sage-800 do design system mas não igual a nenhum dos
     dois — por isso hardcoded aqui, não um var(--token)).
     Texto permanece claro (herda as regras da base acima): fundo escuro
     de novo, diferente da 1ª versão mobile (verde pastel + texto escuro).
     40px exatos entre o fim do menu fixo (--header-h: 72px) e a etiqueta.
     Os 2 botões saem (o form completo, que aparece no lugar deles, já
     tem o próprio CTA de envio — os dois juntos ficavam redundantes). */
  @media (max-width: 759px) {
    .hero__bg { background: #354a3b; }
    .hero__inner { padding-top: calc(var(--header-h) + 40px); }
    .hero__actions { display: none; }
    .hero__form-mobile { display: block; margin-top: 28px; }
  }
</style>

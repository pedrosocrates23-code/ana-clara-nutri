---
// Hero da home (redesign 01/11/2026).
// Foto: still life editorial gerado pelo Codex e ampliado 2x no Magnific (3832px), SEM pessoa:
// o CFN 856/2026 art. 38 veda IA generativa simulando pessoa real; a foto real da Ana fica
// na seção "Sobre". O lado esquerdo da foto é parede verde escura, onde o texto se apoia.
// É <img> com srcset (não background-image): o navegador escolhe a largura certa e o
// preload em <head> antecipa o LCP.
//
// Conversão: dois botões de WhatsApp, um por formato. Escolher entre duas opções concretas
// pesa menos do que decidir "agendar ou não" (micro-compromisso), e a mensagem já chega
// pré-preenchida com o formato.
import Button from './Button.astro';
import { HAS_CRN, CRN, waLink, WA_MSG } from '../lib/site';
import { heroSources } from '../lib/hero';
const { desk, mob } = heroSources();
---
<section class="hero" aria-label="Apresentação" data-wa-secao="Home · hero">
  <div class="hero__media">
    {desk && (
      <picture>
        {mob && <source media="(max-width: 760px)" srcset={mob.srcset} sizes={mob.sizes} width={mob.width} height={mob.height} type="image/webp" />}
        <img class="hero__img" src={desk.src} srcset={desk.srcset} sizes={desk.sizes} width={desk.width} height={desk.height}
          alt="Mesa de pedra com tigelas de cerâmica artesanal com folhas verdes, grão-de-bico, figos e tomates, jarra de água e guardanapo de linho diante de uma parede verde-escura"
          loading="eager" decoding="sync" fetchpriority="high" />
      </picture>
    )}
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="kicker hero__kicker">Nutricionista{HAS_CRN ? ` · ${CRN}` : ''}</p>
      <h1 class="hero__title">
        <span class="hero__line">Nutrição com abordagem</span>
        <span class="hero__line"><em>comportamental e educacional</em></span>
      </h1>
      <p class="hero__sub">
        Atendimento presencial em Goiânia e online por telenutrição para todo o Brasil.
        Um cuidado próximo, baseado em evidências e sem dietas restritivas.
      </p>

      <p class="hero__ask">Como você prefere ser atendida?</p>
      <div class="hero__actions">
        <Button href={waLink(WA_MSG.online)} variant="light" size="lg" secao="Home · hero · online" magnetic>Consulta online</Button>
        <Button href={waLink(WA_MSG.presencial)} variant="outline-light" size="lg" secao="Home · hero · presencial">Presencial em Goiânia</Button>
      </div>

      <ul class="hero__trust" role="list">
        <li>Formada pela UFG</li>
        <li>Atendimento particular</li>
        <li>Agendamento direto com a Ana</li>
      </ul>
    </div>
  </div>

  <a href="#sobre" class="hero__scroll" aria-label="Rolar para conhecer a Ana Clara"><span></span></a>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: min(100svh, 940px); display: flex; align-items: center;
    background: var(--forest-ink); color: #fff;
  }
  .hero__media { position: absolute; inset: 0; z-index: -2; }
  .hero__media :global(.hero__img) {
    width: 100%; height: 100%; object-fit: cover; object-position: 72% center;
    animation: hero-in 2.4s var(--ease-out) both;
  }
  @keyframes hero-in { from { transform: scale(1.07); } to { transform: scale(1); } }
  /* Sombra só onde o texto pousa: a parede da foto já é escura, o degradê garante 4.5:1
     no texto mesmo em telas estreitas, onde a foto é recortada e a comida chega perto do texto. */
  .hero__shade {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(20, 30, 23, .82) 0%, rgba(20, 30, 23, .55) 38%, rgba(20, 30, 23, 0) 62%),
      linear-gradient(0deg, rgba(20, 30, 23, .55) 0%, rgba(20, 30, 23, 0) 28%);
  }
  .hero__inner { width: 100%; padding-block: calc(var(--header-h) + 48px) 96px; }
  .hero__content { max-width: 620px; }
  .hero__kicker { color: var(--sage-200); }
  .hero__title { color: #fff; font-weight: 300; font-size: clamp(2.5rem, 6vw, 4.6rem); line-height: 1.02; margin: 20px 0 0; letter-spacing: -.03em; }
  .hero__line { display: block; animation: line-up 1.1s var(--ease-out) both; }
  .hero__line + .hero__line { animation-delay: .08s; }
  .hero__title em { font-style: italic; color: var(--sage-200); }
  @keyframes line-up { from { transform: translateY(18px); } to { transform: none; } }
  .hero__sub { color: rgba(255, 255, 255, .88); font-size: clamp(1.02rem, 1.5vw, 1.18rem); margin: 22px 0 0; max-width: 500px; line-height: 1.6; }
  .hero__ask { margin: 34px 0 12px; font-family: var(--mono); font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; color: var(--sage-200); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__trust { list-style: none; padding: 0; margin: 34px 0 0; display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: .88rem; color: rgba(255, 255, 255, .78); }
  .hero__trust li { display: inline-flex; align-items: center; gap: 8px; }
  .hero__trust li::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--sage-300); }

  .hero__scroll { position: absolute; left: 50%; bottom: 26px; translate: -50% 0; width: 26px; height: 42px; border: 1.5px solid rgba(255,255,255,.5); border-radius: 14px; }
  .hero__scroll span { position: absolute; left: 50%; top: 8px; width: 3px; height: 8px; margin-left: -1.5px; border-radius: 2px; background: #fff; animation: scroll-dot 2s var(--ease-out) infinite; }
  @keyframes scroll-dot { 0% { transform: translateY(0); opacity: 0; } 30% { opacity: 1; } 100% { transform: translateY(14px); opacity: 0; } }

  /* Celular: a foto (recorte quadrado) ocupa só o topo; abaixo dela o hero continua no verde
     da parede (--forest-ink), onde o texto se apoia. O degradê funde a foto nesse verde. */
  @media (max-width: 760px) {
    .hero { align-items: flex-end; min-height: 100svh; }
    .hero__media { inset: 0 0 auto 0; height: min(64svh, 560px); }
    .hero__media :global(.hero__img) { object-position: center 45%; }
    .hero__shade {
      inset: 0 0 auto 0; height: min(64svh, 560px);
      background: linear-gradient(180deg, rgba(26, 38, 29, .35) 0%, rgba(26, 38, 29, 0) 22%, rgba(26, 38, 29, .55) 62%, #1A261D 100%);
    }
    .hero__inner { padding-block: calc(min(64svh, 560px) - 150px) 40px; }
    .hero__actions { display: grid; }
    .hero__actions :global(.btn) { width: 100%; }
    .hero__scroll { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__media :global(.hero__img), .hero__line, .hero__scroll span { animation: none; }
  }
</style>

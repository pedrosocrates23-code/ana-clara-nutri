---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import PostCard from '../../components/PostCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import AreasGrid from '../../components/AreasGrid.astro';
import { buildGraph } from '../../lib/schema/shared';

export async function getStaticPaths() {
 const silos = await getCollection('silos');
 return silos.map((entry) => ({ params: { silo: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const path = `/${entry.id}/`;

// Spokes publicados deste silo. O hub linka para eles: é o que fecha o siloing.
// Enquanto não houver nenhum publicado, cai no fallback de spokes planejados (texto).
const publicados = (await getCollection('posts'))
 .filter((p) => p.data.silo === entry.id)
 .sort((a, b) => (a.data.datePublished < b.data.datePublished ? 1 : -1));

const breadcrumb = [
 { name: 'Início', href: '/' },
 { name: 'Áreas de atuação', href: '/#atendimento' },
 { name: data.title, href: path },
];

const graph = buildGraph({
 path, title: data.metaTitle, type: 'CollectionPage',
 mainEntity: undefined, faqs: data.faqs, breadcrumb,
});

const msg = `Olá, Ana Clara! Vim pela página de ${data.title} e gostaria de agendar uma consulta.`;
---
<BaseLayout title={data.metaTitle} description={data.description} path={path} graph={graph}>
 <PageHero kicker={data.kicker} title={data.h1} sub={data.sub}
  cta={{ label: 'Agendar pelo WhatsApp', waMsg: msg, secao: `Área · ${data.title} · topo` }}
  secondary={{ label: 'Como eu atendo', href: '/como-eu-atendo/' }}
  breadcrumb={breadcrumb} image={`silo-${entry.id}`} />

 <section class="section">
  <div class="container hub">
   <div class="prose">
    <Content />
   </div>
   <div class="hub__author"><AuthorBox /></div>
  </div>
 </section>

 {publicados.length > 0 && (
  <section class="section section--alt">
   <div class="container">
    <div class="section__head section__head--split">
     <div>
      <span class="kicker">Aprofunde no tema</span>
      <h2>O que você vai <em>encontrar</em></h2>
     </div>
     <p>{publicados.length} {publicados.length === 1 ? 'texto' : 'textos'} desta área, do mais recente ao mais antigo.</p>
    </div>
    <div class="spokes">
     {publicados.map((p) => <PostCard post={p} />)}
    </div>
   </div>
  </section>
 )}

 {publicados.length === 0 && data.spokes.length > 0 && (
  <section class="section section--alt">
   <div class="container">
    <div class="section__head"><span class="kicker">Aprofunde no tema</span><h2>O que você vai encontrar</h2></div>
    <ul class="spokes-plan">
     {data.spokes.map((s) => <li>{s}</li>)}
    </ul>
    <p class="muted">Conteúdos em produção, em breve publicados nesta área.</p>
   </div>
  </section>
 )}

 {data.faqs.length > 0 && <Faq items={data.faqs} />}

 <section class="section section--sand">
  <div class="container">
   <div class="section__head"><span class="kicker">Outras áreas</span><h2>Também posso te <em>acompanhar</em> em</h2></div>
   <AreasGrid exclude={[path]} />
  </div>
 </section>

 <CtaBand title="Quer trabalhar <em>esse tema</em>?" secao={`Área · ${data.title} · faixa final`} image={`silo-${entry.id}`} />
</BaseLayout>

<style>
 .hub { display: grid; gap: 0; }
 .hub__author { max-width: var(--maxw-prose); }
 .spokes { display: grid; gap: 22px; }
 @media (min-width: 720px) { .spokes { grid-template-columns: repeat(2, 1fr); } }
 @media (min-width: 1100px) { .spokes { grid-template-columns: repeat(3, 1fr); } }
 .spokes-plan { list-style: none; padding: 0; display: grid; gap: 10px; max-width: var(--maxw-prose); }
 .spokes-plan li { background: #fff; border: 1px solid var(--line); border-radius: var(--r-md); padding: 14px 18px; color: var(--ink); font-weight: 500; }
 .muted { color: var(--ink-faint); font-size: .85rem; margin-top: 14px; }
</style>

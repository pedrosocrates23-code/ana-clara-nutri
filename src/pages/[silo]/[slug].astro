---
import { getCollection } from 'astro:content';
import ArticlePage from '../../components/ArticlePage.astro';
import LpPage from '../../components/LpPage.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    // Só páginas de 2 níveis (/silo/pagina). As netas (/silo/mae/pagina) saem de [sub]/[slug].astro.
    .filter((p) => p.data.silo !== 'blog' && p.data.path.split('/').filter(Boolean).length === 2)
    .map((entry) => ({ params: { silo: entry.data.silo, slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
// layout 'lp' = página de conversão com intenção local (blocos visíveis + guia recolhido).
const isLp = entry.data.layout === 'lp' && entry.data.lp;
---
{isLp ? <LpPage entry={entry} /> : <ArticlePage entry={entry} />}

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { buildGraph } from '../../lib/schema/shared';

const posts = (await getCollection('posts')).sort(
 (a, b) => (a.data.datePublished < b.data.datePublished ? 1 : -1)
);
const breadcrumb = [{ name: 'Início', href: '/' }, { name: 'Blog', href: '/blog' }];
const graph = buildGraph({ path: '/blog', title: 'Blog | Ana Clara Nutri', breadcrumb });

// Filtro por área: só as áreas que têm artigo publicado, na ordem de quantidade.
const contagem = new Map<string, { label: string; n: number }>();
for (const p of posts) {
 const c = contagem.get(p.data.silo) ?? { label: p.data.silo === 'blog' ? 'Primeiros passos' : p.data.siloLabel, n: 0 };
 c.n += 1;
 contagem.set(p.data.silo, c);
}
const areas = [...contagem.entries()].sort((a, b) => b[1].n - a[1].n);
const [destaque, ...resto] = posts;
---
<BaseLayout
 title="Blog | Ana Clara Nutri"
 description="Conteúdo sobre alimentação, comportamento e saúde, em linguagem simples e baseada em evidências."
 path="/blog" graph={graph}>
 <PageHero kicker="Conteúdo" title="Blog: alimentação, comportamento e <em>saúde</em>"
  sub="Textos em linguagem simples e baseada em evidências, para entender o que acontece entre você e a comida antes de mudar qualquer coisa."
  breadcrumb={breadcrumb} image="pg-blog" imageAlt="Caderno aberto em branco sobre linho, xícara de chá, castanhas, pera fatiada e ramo de alecrim" />

 <section class="section">
  <div class="container">
   {posts.length === 0 ? (
    <p class="muted">Em breve, novos conteúdos por aqui.</p>
   ) : (
    <>
     <div class="filtros" role="group" aria-label="Filtrar artigos por área" data-filtros>
      <button type="button" class="chip" aria-pressed="true" data-filtro="todos">Todos <span>{posts.length}</span></button>
      {areas.map(([silo, a]) => (
       <button type="button" class="chip" aria-pressed="false" data-filtro={silo}>{a.label} <span>{a.n}</span></button>
      ))}
     </div>
     <p class="sr-only" aria-live="polite" data-filtro-status></p>
     <div class="lista" data-lista>
      {/* h2, não h3: o h1 da página é o do topo e cada card é uma seção direta dele. */}
      <PostCard post={destaque} heading="h2" featured />
      {resto.map((p) => <PostCard post={p} heading="h2" />)}
     </div>
    </>
   )}
  </div>
 </section>

 <CtaBand secao="Blog · faixa final" />
</BaseLayout>

<script>
 const root = document.querySelector<HTMLElement>('[data-filtros]');
 const lista = document.querySelector<HTMLElement>('[data-lista]');
 const status = document.querySelector<HTMLElement>('[data-filtro-status]');
 if (root && lista) {
  const cards = [...lista.querySelectorAll<HTMLElement>('[data-silo]')];
  root.addEventListener('click', (e) => {
   const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filtro]');
   if (!btn) return;
   const f = btn.dataset.filtro!;
   root.querySelectorAll('[data-filtro]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
   lista.classList.toggle('is-filtered', f !== 'todos');
   let n = 0;
   cards.forEach((c) => {
    const show = f === 'todos' || c.dataset.silo === f;
    c.hidden = !show;
    if (show) { n++; c.style.opacity = '1'; c.style.transform = 'none'; c.animate?.([{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'none' }], { duration: 500, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', delay: Math.min(n, 8) * 35, fill: 'backwards' }); }
   });
   if (status) status.textContent = `${n} ${n === 1 ? 'artigo' : 'artigos'}`;
  });
 }
</script>

<style>
 .filtros { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: clamp(28px, 4vw, 44px); }
 .chip {
  font: inherit; font-size: .92rem; font-weight: 550; cursor: pointer;
  padding: 10px 16px; border-radius: 999px; border: 1px solid var(--line-strong); background: #fff; color: var(--ink);
  display: inline-flex; align-items: center; gap: 8px; transition: background .25s, color .25s, border-color .25s;
 }
 .chip span { font-family: var(--mono); font-size: .72rem; color: var(--ink-faint); }
 .chip:hover { border-color: var(--sage-500); }
 .chip[aria-pressed='true'] { background: var(--sage-800); color: #fff; border-color: var(--sage-800); }
 .chip[aria-pressed='true'] span { color: var(--sage-200); }
 .lista { display: grid; gap: 24px; }
 @media (min-width: 720px) { .lista { grid-template-columns: repeat(2, 1fr); } }
 @media (min-width: 1100px) { .lista { grid-template-columns: repeat(3, 1fr); } }
 /* Com filtro ativo o destaque vira card comum (senão ocupa a linha inteira sozinho) */
 .lista.is-filtered :global(.pcard--featured) { grid-column: auto; flex-direction: column; }
 .lista.is-filtered :global(.pcard--featured .pcard__media) { flex: none; aspect-ratio: 3 / 2; min-height: 0; }
 .lista.is-filtered :global(.pcard--featured .pcard__body) { padding: 22px 24px; }
 .lista.is-filtered :global(.pcard--featured .pcard__title) { font-size: 1.32rem; }
 .lista :global([hidden]) { display: none !important; }
 .muted { color: var(--ink-faint); }
</style>

---
// Agendamento (01/11/2026): a conversão do site passou a ser SÓ WhatsApp. O formulário
// (FormCard → Google Sheets) saiu; a URL /contato continua, porque já está indexada e
// recebe links internos e externos.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { SITE, TEL_URL, HAS_CRN, CRN, HAS_INSTAGRAM, waLink, WA_MSG } from '../lib/site';
import { buildGraph } from '../lib/schema/shared';
const breadcrumb = [{ name: 'Início', href: '/' }, { name: 'Contato', href: '/contato' }];
const graph = buildGraph({ path: '/contato', title: 'Agendar consulta | Ana Clara Nutri', mainEntity: 'business', breadcrumb });

const opcoes = [
 { t: 'Consulta online', d: 'Telenutrição por vídeo, para qualquer cidade do Brasil.', msg: WA_MSG.online, secao: 'Contato · online', destaque: true },
 { t: 'Consulta presencial', d: `No ${SITE.venue}, em Goiânia.`, msg: WA_MSG.presencial, secao: 'Contato · presencial', destaque: true },
 { t: 'Saber os valores', d: 'O investimento é informado antes de qualquer agendamento.', msg: WA_MSG.valores, secao: 'Contato · valores' },
 { t: 'Tirar uma dúvida', d: 'Pergunte o que quiser antes de decidir, sem compromisso.', msg: WA_MSG.duvida, secao: 'Contato · dúvida' },
];
---
<BaseLayout
 title="Agendar consulta | Ana Clara Nutri"
 description="Agende sua consulta nutricional com Ana Clara pelo WhatsApp, online (telenutrição) para todo o Brasil ou presencial em Goiânia. Atendimento particular."
 path="/contato" graph={graph}>
 <PageHero kicker="Agendamento" title="Vamos cuidar da sua <em>alimentação</em>?"
  sub="O agendamento é feito pelo WhatsApp, direto com a Ana. Atendimento particular, online para todo o Brasil e presencial em Goiânia."
  cta={{ label: 'Chamar no WhatsApp', secao: 'Contato · topo' }}
  breadcrumb={breadcrumb} image="pg-agendar" imageAlt="Agenda de papel aberta sobre mesa de carvalho com caneca de café, ervas frescas e copo de água sob luz da manhã" />

 <section class="section">
  <div class="container">
   <div class="section__head">
    <span class="kicker">Escolha por onde começar</span>
    <h2>Cada botão abre o WhatsApp com a <em>mensagem pronta</em></h2>
    <p>É só tocar, conferir e enviar. Você não precisa explicar tudo de uma vez: a conversa começa daí.</p>
   </div>
   <div class="opcoes">
    {opcoes.map((o) => (
     <a class:list={['opcao', { 'opcao--destaque': o.destaque }]} href={waLink(o.msg)} target="_blank" rel="noopener" data-wa-secao={o.secao} data-reveal>
      <span class="opcao__ico" aria-hidden="true"></span>
      <span class="opcao__t">{o.t}</span>
      <span class="opcao__d">{o.d}</span>
      <span class="opcao__msg">“{o.msg}”</span>
      <span class="opcao__go">Abrir conversa <span aria-hidden="true">→</span></span>
     </a>
    ))}
   </div>
   <p class="contato-alt">
    Prefere ligar? <a href={TEL_URL}>{SITE.phone}</a>.
    {HAS_INSTAGRAM && <> Instagram: <a href={SITE.social.instagram} rel="me noopener" target="_blank">{SITE.social.instagram}</a>.</>}
    {' '}Atendimento exclusivamente particular (sem convênios).{HAS_CRN ? ` ${CRN}.` : ''}
   </p>
  </div>
 </section>

 <section class="section section--alt" id="o-que-acontece-depois">
  <div class="container depois">
   <div class="section__head">
    <span class="kicker">Depois que você chama</span>
    <h2>O que acontece depois da <em>primeira mensagem</em></h2>
   </div>
   <div class="prose">
    <p>Sou eu quem lê cada mensagem que chega por aqui, não uma equipe de triagem. Costumo responder ainda no mesmo dia útil. Se você escrever fora do horário comercial, a resposta vem no próximo dia útil.</p>
    <p>Vale contar, em poucas palavras, o que você está buscando, por exemplo um desconforto digestivo recorrente ou dificuldade para manter uma rotina alimentar. Assim eu já chego no primeiro retorno entendendo o motivo da consulta, sem precisar que você repita tudo depois.</p>
    <p>O que você escreve fica só entre nós. É <strong>sigilo profissional</strong>, o mesmo que rege qualquer atendimento nutricional, e os dados são tratados exclusivamente para organizar o seu agendamento.</p>
    <p>Sobre o valor: informo o investimento com transparência já no primeiro contato, antes de qualquer agendamento. Não existe letra miúda nem cobrança combinada só depois da consulta.</p>
    <p>Na conversa, combinamos juntas a data, o horário e a modalidade, online por telenutrição ou presencial no consultório.</p>
   </div>
  </div>
 </section>

 <section class="section">
  <div class="container">
   <div class="section__head">
    <span class="kicker">Como chegar</span>
    <h2>Onde fica o <em>atendimento presencial</em></h2>
    <p>O atendimento presencial acontece no <strong>{SITE.venue}</strong>, na {SITE.address.street}, em {SITE.address.locality} - {SITE.address.region}. Se preferir a consulta online, a telenutrição cobre todo o Brasil.</p>
   </div>
   <MapEmbed />
  </div>
 </section>
</BaseLayout>

<style>
 .opcoes { display: grid; gap: 18px; }
 @media (min-width: 720px) { .opcoes { grid-template-columns: repeat(2, 1fr); } }
 .opcao {
  position: relative; display: grid; gap: 8px; padding: 28px 28px 24px; border-radius: var(--r-xl);
  background: #fff; border: 1px solid var(--line); color: var(--ink); text-decoration: none; overflow: hidden;
  transition: transform .5s var(--ease-out), box-shadow .5s var(--ease-out), border-color .3s;
 }
 .opcao:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); border-color: var(--sage-300); }
 .opcao--destaque { background: var(--forest-ink); color: #fff; border-color: var(--forest-ink); }
 .opcao__ico { width: 44px; height: 44px; border-radius: 50%; background: var(--sage-100); position: relative; margin-bottom: 6px; }
 .opcao__ico::after { content: ''; position: absolute; inset: 11px; background: var(--sage-800); -webkit-mask: var(--wa-icon) center / contain no-repeat; mask: var(--wa-icon) center / contain no-repeat; }
 .opcao--destaque .opcao__ico { background: var(--sage-200); }
 .opcao__t { font-family: var(--serif); font-size: clamp(1.5rem, 2.4vw, 1.9rem); line-height: 1.1; }
 .opcao__d { color: var(--ink-soft); }
 .opcao--destaque .opcao__d { color: rgba(255,255,255,.8); }
 .opcao__msg { margin-top: 8px; padding: 12px 14px; border-radius: 4px 14px 14px 14px; background: var(--sage-50); color: var(--sage-900); font-size: .88rem; line-height: 1.5; }
 .opcao--destaque .opcao__msg { background: rgba(255,255,255,.08); color: rgba(255,255,255,.88); }
 .opcao__go { margin-top: 10px; font-weight: 650; color: var(--sage-700); }
 .opcao--destaque .opcao__go { color: var(--sage-200); }
 .opcao__go span { display: inline-block; transition: transform .4s var(--ease-out); }
 .opcao:hover .opcao__go span { transform: translateX(5px); }
 .contato-alt { margin-top: 26px; color: var(--ink-soft); font-size: .95rem; max-width: none; }
 .contato-alt a { color: var(--sage-700); font-weight: 600; }
 .depois { display: grid; gap: 0; }
 @media (min-width: 960px) { .depois { grid-template-columns: .8fr 1.2fr; gap: 72px; } }
</style>
